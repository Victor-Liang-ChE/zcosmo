+def weights(grid):
+    grid=np.asarray(grid,float);assert grid[0]==0 and grid[-1]==1 and (np.diff(grid)>0).all()
+    w=np.zeros(len(grid));dx=np.diff(grid);w[:-1]+=dx/2;w[1:]+=dx/2;return w
